rule targeted:
	input:
		#f"data/{sample}/targeted/fusion/500kbp/{sample}.fusion.500kbp.fastq.gz",
		#f"data/{sample}/targeted/fusion/1Mbp/{sample}.fusion.1Mbp.fastq.gz",
		#f"results/{sample}/targeted/fusion/500kbp/jaffa_results.csv",
		#f"results/{sample}/targeted/fusion/1Mbp/jaffa_results.csv",
		f"data/{sample}/targeted/roi/{sample}.targeted.fastq.gz",	
		f"alignments/{sample}/targeted/roi/{sample}.minimap2.targeted.srt.bam",
		f"alignments/{sample}/targeted/roi/{sample}.ngmlr.targeted.srt.bam",
		f"alignments/{sample}/targeted/roi/{sample}.minimap2.targeted.srt.bam.bai",
		f"qc/{sample}/targeted/roi/{sample}_cov_stats.csv",
		f"results/{sample}/targeted/{sample}.report.targeted.xlsx"

